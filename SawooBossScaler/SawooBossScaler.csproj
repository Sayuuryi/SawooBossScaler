<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- Manifest -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Name>Sawoo Boss Scaler</Name>
    <Author>Sayuuryi</Author>
    <Punchline>Change the size of ultimate bosses, phase by phase.</Punchline>
    <!-- Fixed text shown in the plugin installer. Keep it as is across updates. -->
    <Description>Pick a size for every boss in every phase of the ultimate fights. Type /sbs to open it.</Description>
    <RepoUrl>https://github.com/Sayuuryi/SawooBossScaler</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Sayuuryi/SawooBossScaler/main/SawooBossScaler/Assets/icon.png</IconUrl>
    <Tags>ultimate;boss;size;scale</Tags>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SawooBossScaler.Core\SawooBossScaler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
